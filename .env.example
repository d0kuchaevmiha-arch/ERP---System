DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db
POSTGRES_PASSWORD=super_secret_db_password
SESSION_SECRET=1234567890abcdef1234567890abcdef
DEMO_PASSWORD=my_demo_password
